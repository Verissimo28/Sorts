def bubble_sort(arr):
    n = len(arr)
    comparacoes = 0
    trocas = 0

    for i in range(n):
        for j in range(0, n - i - 1):
            comparacoes += 1
            if arr[j] > arr[j + 1]:
                arr[j], arr[j + 1] = arr[j + 1], arr[j]
                trocas += 1

    return arr, comparacoes, trocas

def selection_sort(arr):
    n = len(arr)
    comparacoes = 0
    trocas = 0

    for i in range(n):
        menor_indice = i

        for j in range(i + 1, n):
            comparacoes += 1
            if arr[j] < arr[menor_indice]:
                menor_indice = j

        if menor_indice != i:
            arr[i], arr[menor_indice] = arr[menor_indice], arr[i]
            trocas += 1

    return arr, comparacoes, trocas

vetor = [9, 8, 7, 6, 5, 4, 3, 2, 1]

_, comp_bubble, troc_bubble = bubble_sort(vetor.copy())
_, comp_selection, troc_selection = selection_sort(vetor.copy())

print("Bubble Sort - Comparações:", comp_bubble, "Trocas:", troc_bubble)
print("Selection Sort - Comparações:", comp_selection, "Trocas:", troc_selection)
