def insertion_sort(arr):
    for i in range(1, len(arr)):
        chave = arr[i]
        j = i - 1
        while j >= 0 and arr[j] > chave:
            arr[j + 1] = arr[j]
            j -= 1
        arr[j + 1] = chave
    return arr

def particao(arr, inicio, fim):
    pivo = arr[fim]
    i = inicio - 1

    for j in range(inicio, fim):
        if arr[j] < pivo:
            i += 1
            arr[i], arr[j] = arr[j], arr[i]

    arr[i + 1], arr[fim] = arr[fim], arr[i + 1]
    return i + 1

def quicksort(arr, inicio, fim):
    if inicio < fim:
        p = particao(arr, inicio, fim)
        quicksort(arr, inicio, p - 1)
        quicksort(arr, p + 1, fim)
    return arr

def super_sort(vetor, tamanho):
    if tamanho < 10:
        print("Usando Insertion Sort")
        return insertion_sort(vetor)
    else:
        print("Usando Quick Sort")
        return quicksort(vetor, 0, tamanho - 1)

vetor_pequeno = [8, 3, 5, 1, 9, 2, 7, 4]
vetor_grande = [15, 3, 12, 6, 9, 20, 1, 18, 7, 14, 2, 11, 5, 13, 4]

print(super_sort(vetor_pequeno.copy(), len(vetor_pequeno)))
print(super_sort(vetor_grande.copy(), len(vetor_grande)))
